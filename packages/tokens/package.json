{
  "name": "@mission-ui/tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens: DTCG 2025.10 source and generated CSS variables, TypeScript constants, and Tailwind theme.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning build/cli.ts && tsc -p tsconfig.dist.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@mission-ui/eslint-config": "workspace:*",
    "@mission-ui/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "colorjs.io": "catalog:",
    "eslint": "catalog:",
    "style-dictionary": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
